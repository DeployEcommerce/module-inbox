<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        Surfaces webhook problems in the admin's own notification area. This is a Magento
        system message rather than an inbox message on purpose: a webhook failure written to
        the inbox would trigger another webhook.
    -->
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="deployecommerce_inbox_webhook_failing" xsi:type="string">DeployEcommerce\Inbox\Model\Webhook\Message\Failing</item>
            </argument>
        </arguments>
    </type>
</config>
