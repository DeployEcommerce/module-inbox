{
    "name": "deployecommerce/module-inbox",
    "description": "Admin inbox for messages posted by integrations and other modules, with retention, optional deduplication and queued outbound forwarding.",
    "type": "magento2-module",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "magento/framework": "*",
        "magento/module-backend": "*",
        "magento/module-config": "*",
        "magento/module-cron": "*",
        "magento/module-ui": "*",
        "monolog/monolog": "^3.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DeployEcommerce\\Inbox\\": ""
        }
    },
    "keywords": [
        "magento",
        "magento2",
        "admin",
        "logging",
        "notifications",
        "integrations"
    ],
    "require-dev": {
        "pestphp/pest": "^2.36",
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "pest"
    }
}
