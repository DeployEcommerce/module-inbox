<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">deployecommerce_inbox_message_listing.deployecommerce_inbox_message_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>deployecommerce_inbox_message_columns</spinner>
        <deps>
            <dep>deployecommerce_inbox_message_listing.deployecommerce_inbox_message_listing_data_source</dep>
        </deps>
    </settings>

    <dataSource name="deployecommerce_inbox_message_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">message_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>DeployEcommerce_Inbox::message</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="deployecommerce_inbox_message_listing_data_source">
            <settings>
                <requestFieldName>message_id</requestFieldName>
                <primaryFieldName>message_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
        <massaction name="listing_massaction">
            <settings>
                <selectProvider>deployecommerce_inbox_message_listing.deployecommerce_inbox_message_listing.deployecommerce_inbox_message_columns.ids</selectProvider>
            </settings>
            <action name="mark_read">
                <settings>
                    <type>mark_read</type>
                    <label translate="true">Mark as Read</label>
                    <url path="deployecommerce_inbox/message/massStatus">
                        <param name="status">read</param>
                    </url>
                </settings>
            </action>
            <action name="mark_unread">
                <settings>
                    <type>mark_unread</type>
                    <label translate="true">Mark as Unread</label>
                    <url path="deployecommerce_inbox/message/massStatus">
                        <param name="status">unread</param>
                    </url>
                </settings>
            </action>
            <action name="pin">
                <settings>
                    <type>pin</type>
                    <label translate="true">Keep Indefinitely</label>
                    <url path="deployecommerce_inbox/message/massPin">
                        <param name="pin">1</param>
                    </url>
                </settings>
            </action>
            <action name="unpin">
                <settings>
                    <type>unpin</type>
                    <label translate="true">Stop Keeping Indefinitely</label>
                    <confirm>
                        <title translate="true">Stop keeping these messages?</title>
                        <message translate="true">They will be removed by the cleanup job once they pass their retention age, which may be tonight.</message>
                    </confirm>
                    <url path="deployecommerce_inbox/message/massPin">
                        <param name="pin">0</param>
                    </url>
                </settings>
            </action>
            <action name="delete">
                <settings>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                    <confirm>
                        <title translate="true">Delete messages</title>
                        <message translate="true">Are you sure you want to permanently delete the selected messages?</message>
                    </confirm>
                    <url path="deployecommerce_inbox/message/massDelete"/>
                </settings>
            </action>
        </massaction>
    </listingToolbar>

    <modal name="message_modal">
        <settings>
            <options>
                <option name="title" xsi:type="string" translate="true">Message</option>
                <option name="type" xsi:type="string">slide</option>
            </options>
        </settings>
        <container name="message_view"
                   component="DeployEcommerce_Inbox/js/message-view"
                   template="DeployEcommerce_Inbox/message-view">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="viewUrl" xsi:type="url" path="deployecommerce_inbox/message/view"/>
                    <item name="setStatusUrl" xsi:type="url" path="deployecommerce_inbox/message/setStatus"/>
                    <item name="listingProvider" xsi:type="string">deployecommerce_inbox_message_listing.deployecommerce_inbox_message_listing_data_source</item>
                </item>
            </argument>
        </container>
    </modal>

    <columns name="deployecommerce_inbox_message_columns">
        <settings>
            <childDefaults>
                <!--
                    Clicking anywhere in a row runs the actions column's view action, so the
                    row click and the View link share one path. The checkbox and actions
                    columns render their own templates and do not inherit this, so they keep
                    working normally.
                -->
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">deployecommerce_inbox_message_listing.deployecommerce_inbox_message_listing.deployecommerce_inbox_message_columns.actions</item>
                    <item name="target" xsi:type="string">applyAction</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">view</item>
                        <item name="1" xsi:type="string">${ $.$data.rowIndex }</item>
                    </item>
                </param>
            </childDefaults>
        </settings>

        <selectionsColumn name="ids">
            <settings>
                <indexField>message_id</indexField>
            </settings>
        </selectionsColumn>

        <column name="message_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <visible>false</visible>
            </settings>
        </column>

        <column name="is_read" component="Magento_Ui/js/grid/columns/select" sortOrder="20">
            <settings>
                <options class="DeployEcommerce\Inbox\Model\Config\Source\Status"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>

        <column name="severity"
                class="DeployEcommerce\Inbox\Ui\Component\Listing\Column\Severity"
                component="DeployEcommerce_Inbox/js/grid/columns/severity" sortOrder="30">
            <settings>
                <options class="DeployEcommerce\Inbox\Model\Config\Source\Severity"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Severity</label>
            </settings>
        </column>

        <!-- Not sortable: no index covers title, so ordering by it would sort the whole
             table. Filtering is indexed-adjacent and cheap; sorting is not. -->
        <column name="title" sortOrder="40">
            <settings>
                <filter>text</filter>
                <sortable>false</sortable>
                <label translate="true">Title</label>
            </settings>
        </column>

        <column name="source" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Source</label>
            </settings>
        </column>

        <column name="tags"
                class="DeployEcommerce\Inbox\Ui\Component\Listing\Column\Tags"
                component="DeployEcommerce_Inbox/js/grid/columns/tags" sortOrder="60">
            <settings>
                <filter>text</filter>
                <sortable>false</sortable>
                <label translate="true">Tags</label>
            </settings>
        </column>

        <!-- Not sortable for the same reason as title. It is also always 1 unless
             deduplication is enabled, so ordering by it would usually mean nothing. -->
        <column name="occurrences" sortOrder="70">
            <settings>
                <filter>textRange</filter>
                <sortable>false</sortable>
                <label translate="true">Count</label>
            </settings>
        </column>

        <column name="never_delete" component="Magento_Ui/js/grid/columns/select" sortOrder="80">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Kept</label>
            </settings>
        </column>

        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="90">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <sorting>desc</sorting>
                <label translate="true">Created</label>
            </settings>
        </column>

        <actionsColumn name="actions"
                       class="DeployEcommerce\Inbox\Ui\Component\Listing\Column\MessageActions"
                       sortOrder="100">
            <settings>
                <indexField>message_id</indexField>
                <resizeEnabled>false</resizeEnabled>
            </settings>
        </actionsColumn>
    </columns>
</listing>
